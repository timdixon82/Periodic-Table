{
  "name": "periodic-table",
  "version": "0.1.0",
  "description": "Interactive, accessible periodic table of the chemical elements.",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:html": "html-validate index.html",
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint:js": "eslint \"js/**/*.js\" tests",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "html-validate": "^11.17.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "js-yaml": "^4.2.0"
  }
}
